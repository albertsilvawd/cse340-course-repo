<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>
        <p>Select the categories that apply to this service project:</p>

        <form action="/assign-categories/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <% allCategories.forEach(cat=> { %>
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                        <input type="checkbox" id="cat-<%= cat.category_id %>" name="category_ids"
                            value="<%= cat.category_id %>" <%=assignedIds.includes(parseInt(cat.category_id))
                            ? 'checked' : '' %>
                        style="width:18px; height:18px; cursor:pointer; accent-color: var(--color-primary);">
                        <label for="cat-<%= cat.category_id %>" style="font-size:1rem; cursor:pointer;">
                            <%= cat.name %>
                        </label>
                    </div>
                    <% }) %>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Save Categories</button>
                <a href="/project/<%= project.project_id %>" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>