<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= organizationDetails.name %>
        </h2>
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

        <p><strong>Description:</strong>
            <%= organizationDetails.description %>
        </p>
        <p><strong>Contact:</strong>
            <%= organizationDetails.contact_email %>
        </p>

        <h3>Service Projects</h3>
        <ul class="styled-list">
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <div style="margin-top: 20px;">
            <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="btn-primary">✏️ Edit
                Organization</a>
        </div>
    </main>
    <%- include('partials/footer') %>