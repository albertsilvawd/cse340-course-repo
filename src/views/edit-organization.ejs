<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (errors && errors.length> 0) { %>
            <div class="error-box">
                <ul>
                    <% errors.forEach(err=> { %>
                        <li>
                            <%= err.msg %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>

                <form action="/edit-organization/<%= organization.organization_id %>" method="POST">
                    <div class="form-group">
                        <label for="name">Organization Name</label>
                        <input type="text" id="name" name="name" value="<%= organization.name %>" minlength="2"
                            maxlength="150" required>
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="4"
                            required><%= organization.description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="contact_email">Contact Email</label>
                        <input type="email" id="contact_email" name="contact_email"
                            value="<%= organization.contact_email %>" required>
                    </div>

                    <div class="form-group">
                        <label for="logo_filename">Logo Filename</label>
                        <input type="text" id="logo_filename" name="logo_filename"
                            value="<%= organization.logo_filename %>" required>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Save Changes</button>
                        <a href="/organization/<%= organization.organization_id %>" class="btn-secondary">Cancel</a>
                    </div>
                </form>
    </main>
    <%- include('partials/footer') %>