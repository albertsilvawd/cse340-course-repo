<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= category.name %>
        </h2>

        <p>Here are the service projects in this category:</p>

        <ul class="styled-list">
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                    — <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <div style="margin-top: 20px;">
            <a href="/edit-category/<%= category.category_id %>" class="btn-primary">✏️ Edit Category</a>
        </div>
    </main>
    <%- include('partials/footer') %>