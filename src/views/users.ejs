<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>List of all registered users in the system.</p>

        <table style="width:100%;border-collapse:collapse;margin-top:16px;">
            <thead>
                <tr style="background:var(--color-primary);color:white;">
                    <th style="padding:12px 16px;text-align:left;">Name</th>
                    <th style="padding:12px 16px;text-align:left;">Email</th>
                    <th style="padding:12px 16px;text-align:left;">Role</th>
                    <th style="padding:12px 16px;text-align:left;">Registered</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach((u, index)=> { %>
                    <tr
                        style="background:<%= index % 2 === 0 ? 'var(--color-surface)' : 'var(--color-primary-light)' %>;">
                        <td style="padding:12px 16px;border-bottom:1px solid var(--color-border);">
                            <%= u.name %>
                        </td>
                        <td style="padding:12px 16px;border-bottom:1px solid var(--color-border);">
                            <%= u.email %>
                        </td>
                        <td style="padding:12px 16px;border-bottom:1px solid var(--color-border);">
                            <span class="tag <%= u.role_name === 'admin' ? 'tag-active' : 'tag-settled' %>">
                                <%= u.role_name %>
                            </span>
                        </td>
                        <td style="padding:12px 16px;border-bottom:1px solid var(--color-border);">
                            <%= new Date(u.created_at).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                                day: 'numeric' }) %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </main>
    <%- include('partials/footer') %>